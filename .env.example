# ==============================
# MediAssistRover AI Voice Config
# ==============================

# Backend Connection
BACKEND_URL=http://localhost:8080
ROBOT_CODE=ROBOT_MAR_01
DEVICE_SECRET=REPLACE_WITH_PRIVATE_DEVICE_SECRET

# STT Provider: "google" or "whisper"
STT_PROVIDER=whisper

# OpenAI (for Whisper STT + fallback)
OPENAI_API_KEY=sk-your-openai-key

# Google Cloud STT (if using Google)
GOOGLE_APPLICATION_CREDENTIALS=./config/google-credentials.json

# Voice Settings
VOICE_LANGUAGE=vi-VN
VOICE_SAMPLE_RATE=16000
VOICE_SILENCE_THRESHOLD_MS=1500
VOICE_MAX_RECORDING_SEC=15

# TTS Settings
TTS_SPEED_WPM=150

# Logging
LOG_LEVEL=INFO

# Vision uses the same BACKEND_URL / ROBOT_CODE / DEVICE_SECRET above.
VISION_SOURCE=0
VISION_MODE=lower_body
VISION_DELIVERY_ENABLED=false
VISION_SIMULATION=true
# Optional: VISION_MODEL=models/vision/yolov8n-pose.onnx
# Optional: VISION_OUTBOX_PATH=data/vision/outbox/simulation-events.sqlite3

# Admin camera preview (Account ADMIN JWT; previews never send staff alerts).
VISION_ADMIN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to the real Pi address before selecting Raspberry Pi in the admin page.
# VISION_ROBOT_STREAM_URL=http://192.168.1.15:8090/video
# VISION_CAMERA_ALLOWED_HOSTS=192.168.1.15

# Native Pi chat API (run_robot_api.ps1, HTTPS 7861).
# This is different from backend/.env and its private VOICE_SERVICE_TOKEN.
AI_ROBOT_API_TOKEN=REPLACE_WITH_A_RANDOM_PRIVATE_TOKEN_AT_LEAST_32_CHARACTERS
AI_RESPONSE_MODEL=gpt-6-astra
AI_INTENT_MODEL=gpt-6-luna
AI_REASONING_EFFORT=low
EMBEDDING_PROVIDER=local
AI_PRELOAD_CLIENTS=true

# Optional wake recognition ON THE AI HOST, not on the navigation Pi.
# Install sherpa-onnx==1.13.8 and the matching model separately if enabled.
AI_WAKE_ENABLED=false
AI_WAKE_PRELOAD=false
AI_WAKE_PHRASE=Chào cậu
# AI_WAKE_ALIASES=Chào bạn
# AI_WAKE_MODEL_PATH=/absolute/path/to/installed/wake-model
