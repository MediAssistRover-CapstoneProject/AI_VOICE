+"""Offline voice timing summary, audio-config check and PCM processing benchmark."""
+import argparse
+import io
+import json
+import math
+from pathlib import Path
+import statistics
+import sys
+import time
+import wave
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT/'pi'))
+from mediassist.voice_metrics import chat_options, summarize_records
+
+
+def records(paths):
+    count = 0
+    for path in paths:
+        with path.open(encoding='utf-8', errors='replace') as source:
+            for line in source:
+                marker = line.find('VOICE_TIMING ')
+                if marker < 0 or len(line) > 16384:continue
+                try:value = json.loads(line[marker+13:])
+                except ValueError:continue
+                count += 1
+                if count > 100000:raise ValueError('At most 100000 timing records per summary')
+                yield value
+
+
+def benchmark(count):
+    from mediassist.cloud_speech import volume_wav
+    out = io.BytesIO()
+    with wave.open(out, 'wb') as wav:
+        wav.setnchannels(1);wav.setsampwidth(2);wav.setframerate(24000)
+        wav.writeframes(b'\x10\x00'*120000)
+    raw = out.getvalue();samples = []
+    for _ in range(count):
+        start = time.perf_counter();volume_wav(raw, 70)
+        samples.append((time.perf_counter()-start)*1000)
+    return dict(fixture='5 s PCM16 mono 24 kHz; volume 70%; local CPU only', samples=count,
+        p50_ms=round(statistics.median(samples),3),p95_ms=round(sorted(samples)[math.ceil(.95*count)-1],3))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    commands = parser.add_subparsers(dest='command', required=True)
+    p = commands.add_parser('summary');p.add_argument('logs', type=Path, nargs='+')
+    p = commands.add_parser('check-config');p.add_argument('config', type=Path)
+    p = commands.add_parser('bench-pcm');p.add_argument('--iterations', type=int, default=30)
+    p.add_argument('--output', type=Path)
+    args = parser.parse_args()
+    if args.command == 'summary':
+        result = summarize_records(records(args.logs))
+    elif args.command == 'check-config':
+        capture, speech = chat_options(json.loads(args.config.read_text(encoding='utf-8-sig')))
+        result = dict(audio_settings_valid=True, hardware_verified=False, capture=capture, speech=speech)
+    else:
+        if not 10 <= args.iterations <= 10000:parser.error('--iterations must be 10..10000')
+        result = benchmark(args.iterations)
+    output = json.dumps(result, ensure_ascii=False, indent=2)
+    if getattr(args, 'output', None):args.output.write_text(output, encoding='utf-8')
+    print(output)
+
+
+if __name__ == '__main__':main()
