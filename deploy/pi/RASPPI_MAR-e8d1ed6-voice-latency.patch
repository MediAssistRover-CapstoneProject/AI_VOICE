@@ -0,0 +1,106 @@
+"""Per-turn monotonic measurements. Logs contain no audio, speech text or secrets."""
+from contextlib import contextmanager
+import json
+import math
+import re
+import statistics
+import time
+
+from .contracts import StepError
+
+
+def chat_options(config):
+    capture = config.get('capture', {})
+    speech = config.get('speech', {})
+    if not isinstance(capture, dict) or not isinstance(speech, dict):
+        raise StepError('VOICE_CHAT_AUDIO_CONFIG_INVALID')
+    defaults = dict(end_silence_ms=600, tail_silence_ms=150, min_speech_ms=360, threshold=.008)
+    limits = dict(end_silence_ms=(350, 1500), tail_silence_ms=(0, 300),
+                  min_speech_ms=(180, 1000), threshold=(.001, .1))
+    capture = {key: capture.get(key, value) for key, value in defaults.items()}
+    for key, value in capture.items():
+        if (type(value) not in (int, float) or not math.isfinite(value)
+                or not limits[key][0] <= value <= limits[key][1]):
+            raise StepError('VOICE_CHAT_AUDIO_CONFIG_INVALID')
+    speech = dict(speed_wpm=speech.get('speed_wpm', 170), volume=speech.get('volume', 70))
+    if (type(speech['speed_wpm']) is not int or not 80 <= speech['speed_wpm'] <= 220
+            or type(speech['volume']) is not int or not 0 <= speech['volume'] <= 100):
+        raise StepError('VOICE_CHAT_AUDIO_CONFIG_INVALID')
+    return capture, speech
+
+
+class TurnMetrics:
+    def __init__(self, session_id, turn_no, kind='turn'):
+        self.session_id = session_id
+        self.turn_no = turn_no
+        self.kind = kind
+        self.started = time.monotonic()
+        self.last_speech_at = None
+        self.values = {}
+        self.emitted = False
+
+    def elapsed(self, name, start):
+        self.values[name] = round(max(0., time.monotonic() - start) * 1000, 3)
+
+    @contextmanager
+    def stage(self, name):
+        start = time.monotonic()
+        try:
+            yield
+        finally:
+            self.elapsed(name, start)
+
+    def playback_started(self):
+        # Marks aplay invocation, not the first audible sample from the speaker.
+        if self.last_speech_at is not None:
+            self.elapsed('speech_end_to_playback_start_ms', self.last_speech_at)
+
+    def server(self, prefix, value):
+        if type(value) in (int, float) and math.isfinite(value) and value >= 0:
+            self.values[prefix] = value
+
+    def emit(self, status='COMPLETED'):
+        self.emitted = True
+        for prefix in ('ai','stt'):
+            outer=self.values.get(prefix+'_roundtrip_ms')
+            inner=self.values.get(prefix+'_server_ms')
+            if outer is not None and inner is not None and outer>=inner:
+                self.values[prefix+'_transport_and_pi_overhead_ms']=round(outer-inner,3)
+        self.elapsed(self.kind+'_total_ms', self.started)
+        record = dict(schema_version=1, session_id=self.session_id, turn_no=self.turn_no,
+                      status=status, kind=self.kind, measurements_ms=dict(self.values))
+        print('VOICE_TIMING ' + json.dumps(record, separators=(',', ':')), flush=True)
+        return record
+
+
+def summarize_records(records):
+    """Keep successful, silent, failed and cancelled turns in separate groups."""
+    groups = {}
+    for row in records:
+        if not isinstance(row, dict) or row.get('schema_version') != 1:
+            continue
+        status = row.get('status')
+        if status not in ('COMPLETED', 'NO_SPEECH', 'STT_RETRY', 'FAILED', 'CANCELLED'):
+            continue
+        kind = row.get('kind','turn')
+        if kind not in ('turn','session','wake'):continue
+        group = groups.setdefault((kind,status), dict(turns=0, samples={}))
+        group['turns'] += 1
+        values = row.get('measurements_ms', {})
+        if not isinstance(values, dict):continue
+        for key, value in values.items():
+            if (isinstance(key, str) and re.fullmatch(r'[a-z][a-z0-9_]*_ms', key)
+                    and type(value) in (int, float) and math.isfinite(value) and value >= 0):
+                group['samples'].setdefault(key, []).append(value)
+    result = {};events = {}
+    for (kind,status), group in groups.items():
+        stages = {}
+        for key, samples in sorted(group['samples'].items()):
+            ordered = sorted(samples)
+            stages[key] = dict(samples=len(samples), p50_ms=round(statistics.median(samples),3),
+                p95_ms=round(ordered[math.ceil(.95*len(samples))-1],3), max_ms=round(ordered[-1],3))
+        target = result if kind=='turn' else events.setdefault(kind,{})
+        target[status] = dict(turns=group['turns'], stages=stages)
+    output = dict(scope='Pi monotonic spans; playback start is aplay invocation, not verified audible sound', by_status=result)
+    if events:output['events']=events
+    return output
