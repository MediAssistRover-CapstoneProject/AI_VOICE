+"""No robot/network/audio device. Exercise PCM boundaries and timing contracts."""
+import asyncio
+from contextlib import redirect_stdout
+import io
+import json
+from pathlib import Path
+import struct
+import sys
+from types import SimpleNamespace as NS
+import unittest
+from unittest.mock import AsyncMock, Mock, patch
+import wave
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from mediassist.contracts import StepError
+from mediassist.voice_metrics import TurnMetrics, chat_options, summarize_records
+from mediassist.voice_chat import listen
+from mediassist.cloud_speech import PendingAudio, download, volume_wav
+from mediassist.speech import SpeechPlayer
+from mediassist.voice_client import VoiceClient
+
+
+class VoiceLatencyTests(unittest.IsolatedAsyncioTestCase):
+    def test_audio_config_defaults_and_bounds(self):
+        capture,speech=chat_options({})
+        self.assertEqual(capture['end_silence_ms'],600)
+        self.assertEqual(speech['speed_wpm'],170)
+        for bad in ({'capture':{'end_silence_ms':0}}, {'capture':{'threshold':float('nan')}},
+                    {'capture':{'tail_silence_ms':True}}, {'speech':{'speed_wpm':221}},
+                    {'speech':{'speed_wpm':150.5}}, {'speech':{'volume':101}}, {'speech':[]}):
+            with self.subTest(bad=bad),self.assertRaises(StepError):chat_options(bad)
+        self.assertEqual(chat_options({'speech':{'speed_wpm':150},'capture':{'end_silence_ms':900}})[1]['speed_wpm'],150)
+
+    async def capture(self, voiced, silence, **settings):
+        blocks=[struct.pack('<h',1000)*480]*voiced+[b'\0'*960]*silence
+        stream=NS(readexactly=AsyncMock(side_effect=blocks))
+        proc=NS(stdout=stream)
+        player=NS(cfg={'device':'fake-device'},lock=asyncio.Lock(),process=AsyncMock())
+        metrics=TurnMetrics('fixture',1)
+        with patch('mediassist.voice_chat.shutil.which',side_effect=lambda x:'/mock/'+x),\
+             patch('mediassist.voice_chat.asyncio.create_subprocess_exec',new=AsyncMock(return_value=proc)),\
+             patch('mediassist.voice_chat.stop_process',new=AsyncMock()) as stop,\
+             patch('mediassist.voice_chat.asyncio.sleep',new=AsyncMock()),redirect_stdout(io.StringIO()):
+            raw=await listen(player,metrics=metrics,**settings)
+        stop.assert_awaited_once_with(proc)
+        return raw,metrics,stream
+
+    async def test_silence_end_and_trim_preserve_voiced_samples(self):
+        raw,metrics,stream=await self.capture(12,20)
+        self.assertEqual(stream.readexactly.await_count,32)  # 12 speech + 20*30 ms silence
+        with wave.open(io.BytesIO(raw),'rb') as wav:
+            pcm=wav.readframes(wav.getnframes())
+            self.assertEqual(wav.getnframes(),17*480)  # retain only 150 ms tail
+            self.assertEqual(pcm[:12*960],struct.pack('<h',1000)*(12*480))
+            self.assertEqual(pcm[12*960:],b'\0'*(5*960))
+        self.assertEqual(metrics.values['trimmed_silence_ms'],450)
+        self.assertEqual(metrics.values['uploaded_audio_ms'],510)
+
+    async def test_short_noise_ends_after_silence_instead_of_waiting_max_15_seconds(self):
+        raw,_,stream=await self.capture(1,20)
+        self.assertIsNone(raw)
+        self.assertEqual(stream.readexactly.await_count,21)
+
+    async def test_longer_end_silence_profile_is_configurable(self):
+        raw,_,stream=await self.capture(12,30,end_silence_ms=900)
+        self.assertIsNotNone(raw)
+        self.assertEqual(stream.readexactly.await_count,42)
+
+    def test_pcm_volume_fast_path_matches_original_rounding_for_all_widths(self):
+        for width in (1,2,3,4):
+            signed=width!=1
+            values=[0,1,15,127,128,255] if width==1 else [-(2**(width*8-1)), -11,-1,0,1,11,2**(width*8-1)-1]
+            frames=b''.join(x.to_bytes(width,'little',signed=signed) for x in values)
+            out=io.BytesIO()
+            with wave.open(out,'wb') as wav:
+                wav.setnchannels(1);wav.setsampwidth(width);wav.setframerate(24000);wav.writeframes(frames)
+            for volume in (0,30,70,100):
+                with self.subTest(width=width,volume=volume):
+                    expected=[round((x-(128 if width==1 else 0))*volume/100)+(128 if width==1 else 0) for x in values]
+                    with wave.open(io.BytesIO(volume_wav(out.getvalue(),volume)),'rb') as result:
+                        actual=result.readframes(len(values))
+                    self.assertEqual(actual,b''.join(x.to_bytes(width,'little',signed=signed) for x in expected))
+
+    async def test_tts_honors_retry_after_and_shorter_fallback(self):
+        for pending,interval in ((PendingAudio(2),2),(PendingAudio(),.5),(None,.5)):
+            with patch('mediassist.cloud_speech.fetch_once',side_effect=[pending,b'audio']),\
+                 patch('mediassist.cloud_speech.asyncio.sleep',new=AsyncMock()) as sleep:
+                timing={}
+                self.assertEqual(await download({'wait_timeout_sec':5},{'text':'test'},timings=timing),b'audio')
+                self.assertAlmostEqual(sleep.await_args.args[0],interval,places=1)
+                self.assertIn('tts_poll_wait_ms',timing)
+
+    def test_timing_log_does_not_contain_transcripts_and_summary_separates_statuses(self):
+        metric=TurnMetrics('fixture-id',1)
+        metric.last_speech_at=metric.started
+        metric.playback_started()
+        metric.server('stt_roundtrip_ms',500)
+        metric.server('stt_server_ms',400)
+        metric.server('bad_ms',float('nan'))
+        with redirect_stdout(io.StringIO()) as out:record=metric.emit()
+        self.assertTrue(metric.emitted)
+        self.assertNotIn('bad_ms',record['measurements_ms'])
+        self.assertEqual(record['measurements_ms']['stt_transport_and_pi_overhead_ms'],100)
+        self.assertEqual(json.loads(out.getvalue().split('VOICE_TIMING ')[1])['session_id'],'fixture-id')
+        failed=dict(schema_version=1,status='FAILED',measurements_ms={'stt_roundtrip_ms':9999})
+        summary=summarize_records([record,failed,{'rawText':'private transcript'}])
+        self.assertEqual(summary['by_status']['COMPLETED']['stages']['stt_roundtrip_ms']['p50_ms'],500)
+        self.assertEqual(summary['by_status']['FAILED']['turns'],1)
+        self.assertNotIn('private transcript',str(summary))
+
+    def test_summary_keeps_session_and_wake_separate_from_turns(self):
+        rows=[dict(schema_version=1,kind=kind,status='COMPLETED',measurements_ms={kind+'_total_ms':10})
+              for kind in ('turn','session','wake')]
+        result=summarize_records(rows)
+        self.assertEqual(result['by_status']['COMPLETED']['turns'],1)
+        self.assertEqual(result['events']['wake']['COMPLETED']['turns'],1)
+        self.assertNotIn('session_total_ms',result['by_status']['COMPLETED']['stages'])
+
+    async def test_playback_callback_and_tts_timings_preserve_audio_contract(self):
+        out=io.BytesIO()
+        with wave.open(out,'wb') as wav:
+            wav.setnchannels(1);wav.setsampwidth(2);wav.setframerate(16000);wav.writeframes(b'\x10\x00'*100)
+        player=SpeechPlayer({'enabled':True,'engine':'be-tts','device':'fake'})
+        events=[]
+        async def play(_argv,content=None):events.append('play')
+        player.process=play
+        params={'action':'SPEAK','prompt_key':'TEST','data':{'text':'Xin chào','speed_wpm':170}}
+        with patch('mediassist.speech.shutil.which',return_value='/mock/aplay'),\
+             patch('mediassist.cloud_speech.download',new=AsyncMock(return_value=out.getvalue())):
+            result=await player.speak(params,on_playback_start=lambda:events.append('start'))
+        self.assertEqual(events,['start','play'])
+        self.assertTrue(result['values']['playback_completed'])
+        self.assertFalse(result['values']['audible_verified'])
+        self.assertIn('tts_prepare_ms',result['values']['timings_ms'])
+        self.assertIn('playback_ms',result['values']['timings_ms'])
+
+    def test_cli_speed_is_sent_to_backend(self):
+        out=io.BytesIO()
+        with wave.open(out,'wb') as wav:
+            wav.setnchannels(1);wav.setsampwidth(2);wav.setframerate(16000);wav.writeframes(b'\x10\x00'*100)
+        client=VoiceClient.__new__(VoiceClient);client.verbose=False
+        client.request=Mock(return_value=(200,{'Content-Type':'audio/wav'},out.getvalue()))
+        self.assertEqual(client.synthesize('Xin chào','vi',170),out.getvalue())
+        self.assertEqual(json.loads(client.request.call_args.args[1])['speedWpm'],170)
+        with self.assertRaises(StepError):client.synthesize('Xin chào','vi',999)
+
+    async def test_conversation_confirmation_keeps_receipt_and_avoids_rag(self):
+        from mediassist.voice_chat import conversation
+        ai=NS(config={},marker=Path('unused'),request=Mock(return_value={'state':'READY'}),ask=Mock())
+        be=NS(transcribe_result=Mock(return_value={'text':'xác nhận','processingMs':1}))
+        history=Mock();history.start.return_value='session'
+        actions=Mock();actions.consume.return_value=('Đã tiếp nhận.','receipt')
+        with patch('mediassist.voice_chat.AiClient',return_value=ai),\
+             patch('mediassist.voice_chat.VoiceClient',return_value=be),\
+             patch('mediassist.voice_chat.SpeechPlayer'),\
+             patch('mediassist.voice_chat.VoiceActions',return_value=actions),\
+             patch('mediassist.voice_chat.History',return_value=history),\
+             patch('mediassist.voice_chat.listen',new=AsyncMock(return_value=b'pcm')),\
+             patch('mediassist.voice_chat.say',new=AsyncMock()) as say,redirect_stdout(io.StringIO()):
+            dispatched=await conversation({'speech':{}},'unused',initial_catalog={'endpoints':[]},log_transcripts=False)
+        self.assertTrue(dispatched)
+        ai.ask.assert_not_called()
+        self.assertEqual(history.record.call_args.args[-2:],('RESOLVED','receipt'))
+        self.assertEqual(say.await_args_list[-1].kwargs['speech']['speed_wpm'],170)
+        history.close.assert_called_once_with('COMPLETED')
+
+
+if __name__ == '__main__':unittest.main(verbosity=2)
